# Must be "development", "test", or "production" (a typo now fails boot).
# IMPORTANT: anything that is NOT exactly "development"/"test" — including UNSET
# or a misspelling — is treated as production, so the fail-closed config checks
# (src/config/env.validation.ts) can never be silently disabled by omission.
# In production the app refuses to boot if DB_SYNCHRONIZE is true, CORS_ORIGINS
# is "*"/unset, JWT_SECRET is weak/missing, or no malware scanner is configured;
# it also disables Swagger and verbose errors.
NODE_ENV=development
PORT=3000

# Comma-separated allowed frontend origins. MUST be explicit origins in
# production ("*" is rejected at boot when NODE_ENV=production).
CORS_ORIGINS=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=support
DB_PASSWORD=support
DB_NAME=support_platform
# Auto-create schema from entities. DEV ONLY — set false and run migrations in production.
DB_SYNCHRONIZE=true

# Storage: 'local' (disk) or 's3' (S3/MinIO).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# S3/MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=support-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Staff authentication (self-issued JWT) ---
# REQUIRED. A strong random secret the API uses to sign/verify staff HS256 tokens.
# MUST be >= 32 chars of high-entropy randomness in production (a weak key is
# offline-brute-forceable and lets an attacker forge admin tokens). Generate with:
#   openssl rand -hex 32
# The API mints tokens at POST /api/auth/login; create staff via POST /api/admin/staff
# or `npm run seed`.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Rate limiting (per IP). intakeLimit applies to POST /api/reporter/issues.
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_INTAKE_LIMIT=10

# Email (staff notifications). Leave SMTP_HOST blank to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Support Platform <no-reply@support.local>
APP_URL=http://localhost:5173

# Attachment malware scanning. 'noop' (default; marks files SKIPPED, which are
# still SERVED) or 'clamav' (streams to a clamd daemon). In PRODUCTION the app
# refuses to boot unless this is 'clamav' — set ALLOW_UNSCANNED_UPLOADS=true to
# consciously accept serving unscanned files.
SCAN_DRIVER=noop
ALLOW_UNSCANNED_UPLOADS=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Resolution SLA targets (hours from creation) per priority, and the elapsed
# fraction at which an open issue is flagged "at risk". Defaults shown.
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=168
SLA_AT_RISK_FRACTION=0.8

# Per-platform SLA overrides are set in the UI (Admin -> Platforms -> SLA).
# The breach sweep (every 5 min) escalates open issues past their window to
# the assignee/focal points/watchers + webhooks; the Monday digest emails each
# platform's focal points/watchers a weekly summary. Both default ON.
SLA_SWEEP_ENABLED=true
DIGEST_ENABLED=true

# Jira (two-way). Leave blank to disable. JIRA_WEBHOOK_SECRET gates the inbound
# status webhook at POST /api/integrations/jira/webhook (X-Webhook-Token header).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# OD-09 policy seam: may focal points change issue status? Default false.
FOCAL_POINT_CAN_TRANSITION=false

# Self-support (dogfooding): the platform key staff file issues under when they
# click "Get support" in the app. Must match a platform created in
# Admin → Platforms. Defaults to "cimp".
SELF_SUPPORT_PLATFORM_KEY=cimp
